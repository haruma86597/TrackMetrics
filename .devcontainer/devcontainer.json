{
    "name": "TrackMetrics Python 3.12 Dev Container",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "charliermarsh.ruff",
                "google.geminicodeassist",
                "mechatroner.rainbow-csv",
                "clemenspeters.format-json"
            ]
        }
    },
    "postCreateCommand": "pip install -r requirements.txt",
    "remoteUser": "vscode"
}